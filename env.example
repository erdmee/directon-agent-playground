# Copy to .env (git-ignored) and fill the values: cp env.example .env

# --- The three provider keys ---
SONIOX_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# --- Decision model (your own strategy; read with llm.chat(..., prefix="DECISION")) ---
DECISION_API_KEY=
DECISION_BASE_URL=
DECISION_MODEL=

# --- Optional overrides (defaults shown) ---
SONIOX_MODEL=stt-rt-v6
SONIOX_URL=wss://stt-rt.soniox.com/transcribe-websocket
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Kore
GEMINI_CALLER_VOICE=Puck
# Baseline agent LLM; LLM_API_KEY falls back to OPENAI_API_KEY, LLM_BASE_URL to OpenAI.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-5.4-mini
# Leave empty for non-reasoning models.
LLM_REASONING_EFFORT=none
# Empty = in-process mock; set to an official Mock API URL to use it instead.
TOOLS_URL=
PLAYGROUND_NOW=2026-11-21 11:00
